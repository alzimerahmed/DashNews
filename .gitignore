# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
.build/
.swiftpm/

# Resolved-dependency files for the local module packages. These are written
# only when a module is resolved/built standalone (swift build inside the
# module) and aren't used by the app build. The app's lock file at
# DashNews.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
# stays tracked, so dependency versions remain pinned for everyone and CI.
Modules/*/Package.resolved

# Xcode performance-test baselines. Machine-dependent — an M1 ≠ M3 ≠
# Intel. Canonical benchmark numbers belong in source comments next
# to the measure block, where the hardware and config are recorded.
*.xcbaseline



/Shared/Secrets.swift
/Frameworks/Secrets/Secrets.swift
/Modules/Secrets/Sources/Secrets/Secrets.swift
*.py[cod]
/Secrets/Sources/Secrets/SecretKey.swift
/Modules/Secrets/Sources/Secrets/SecretKey.swift

.claude/


# Private agent/knowledge layer — never committed.
/docs/
.devin/
.switchboard/

# Local signing settings created by setup.sh.
/SharedXcodeSettings/
